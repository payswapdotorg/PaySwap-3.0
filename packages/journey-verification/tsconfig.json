{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "journeys.manifest.ts",
    "journeys.coverage.ts",
    "specs/**/*.ts",
    "support/**/*.ts",
    "scripts/**/*.ts"
  ]
}
