{
  // (P18-A) The renderer-mirror + drift-law program: the two renderer
  // files this lane owns, the payswap-app source surface they import,
  // the payswap host shell the drift law asserts against, and the
  // desktop-console-client drift test itself — under the RENDERER
  // settings (dom + jsx + the @payswap/app paths mapping, mirroring
  // tsconfig.renderer.json). Scoped because the full renderer project
  // (five sibling engine sources) exceeds this station's memory.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["es2025", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@payswap/app/routes": ["../payswap-app/src/routes.ts"],
      "@payswap/app": ["../payswap-app/src/index.ts"],
      "@payswap/trust": ["../trust/src/index.ts"]
    }
  },
  "include": [
    "src/host/payswap",
    "src/renderer/src/consoleWorkspaceMount.tsx",
    "src/renderer/src/consolePaymentMissionWire.ts",
    "src/renderer/src/consoleConnectionsWire.ts",
    "src/renderer/src/paymentMissionsComposition.ts",
    "../payswap-app/src",
    "test/payswap/desktop-console-client.test.ts",
    "test/payswap/payment-approval-plane-harness.ts",
    "test/payswap/payment-missions-binding.test.ts",
    "test/payswap/payment-missions-dispatch-binding.test.ts",
    "test/payswap/payment-missions-reconcile-binding.test.ts",
    "test/payswap/payment-dispatch-plane-fixtures.ts",
    "test/payswap/payment-reconcile-plane-fixtures.ts",
    "test/payswap/p21-transport-probe-mirrors.test.ts",
    "test/payswap/connections-bridge.test.ts",
    "../capability/src",
    "../provider-runtime/src",
    "../trust/src"
  ]
}
