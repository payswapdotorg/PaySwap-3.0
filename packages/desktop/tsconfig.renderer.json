{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/renderer",
    "rootDir": "src/renderer",
    "lib": ["es2025", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    // @payswap/app（P9-A）：desktop package.json 归 Lane B（打包身份）管，
    // renderer 以 tsconfig paths 直连 workspace 源码 —— 与 vite 别名一致。
    "paths": {
      "@payswap/app/routes": ["../payswap-app/src/routes.ts"],
      "@payswap/app": ["../payswap-app/src/index.ts"]
    }
  },
  "include": ["src/renderer"],
  // renderer 直接 import 了 shared；把它补进 references，避免 renderer 单独检查时再走源码回退路径。
  "references": [
    { "path": "../shared" },
    { "path": "../ui" },
    { "path": "../client" },
    { "path": "../payswap-app" }
  ]
}
